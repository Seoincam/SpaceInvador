<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Assets/TimeKit/Editor/DebugWindow.uss?fileID=7433441132597879392&amp;guid=effaac82477324d00864be915a50326a&amp;type=3#DebugWindow" />
    <ui:TabView name="timekit-tab-view">
        <ui:Tab label="Summary" name="summary-tab">
            <ui:VisualElement name="clocks-mc-list" class="section" style="flex-grow: 1;">
                <ui:MultiColumnListView name="ClockMcListView" fixed-item-height="25">
                    <ui:Columns>
                        <ui:Column name="clock-type" title="ClockType" width="100px" />
                        <ui:Column name="time" title="Time" width="75px" />
                        <ui:Column name="delta-time" title="Delta Time" width="100px" />
                        <ui:Column name="time-scale" title="Time Scale" width="100px" />
                    </ui:Columns>
                </ui:MultiColumnListView>
            </ui:VisualElement>
        </ui:Tab>
        <ui:Tab label="Clock Types" name="clock-types-tab" />
    </ui:TabView>
</ui:UXML>
