<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Assets/TimeKit/Editor/Debugging/UI/DebugWindow.uss?fileID=7433441132597879392&amp;guid=effaac82477324d00864be915a50326a&amp;type=3#DebugWindow" />
    <ui:TabView name="timekit-tab-view">
        <ui:Tab label="Summary" name="summary-tab" style="font-size: 13px;">
            <ui:ScrollView class="main">
                <ui:VisualElement name="pane2" class="description section-description" style="flex-grow: 1;">
                    <ui:Foldout text="&lt;b&gt;&lt;size=16&gt;&lt;color=#FFE65A&gt;TimeKit — Clock Summary&lt;/color&gt;&lt;/size&gt;&lt;/b&gt;" name="Foldout" enabled="true" focusable="false" toggle-on-label-click="true" value="false" class="description-fold-out" style="-unity-font-style: bold; padding-bottom: 0; margin-bottom: 0; margin-top: 0; margin-right: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-left: 0;">
                        <ui:Label text="&lt;size=11&gt;This panel provides a structured overview of all active &lt;b&gt;&lt;color=#FFD800&gt;TimeKit Clocks&lt;/color&gt;&lt;/b&gt;.&#10;&#10;Each entry displays:&#10;&#10;• &lt;b&gt;&lt;color=#FFD800&gt;Clock Type&lt;/color&gt;&lt;/b&gt; — Identifies the category of the clock  &#10;• &lt;b&gt;Time&lt;/b&gt; — Total elapsed time tracked internally  &#10;• &lt;b&gt;Delta Time&lt;/b&gt; — Tick-by-tick progression amount  &#10;• &lt;b&gt;Time Scale&lt;/b&gt; — Current scaling factor affecting time progression  &#10;• &lt;b&gt;Linked&lt;/b&gt; — Bound behaviours or components associated with this clock&#10;&#10;Use this tool to ensure your game&apos;s timing systems remain consistent and predictable.&#10;&#10;&lt;i&gt;&lt;color=#8F8F8F&gt;Hint:&lt;/color&gt;&lt;/i&gt;  &#10;&lt;i&gt;Yellow indicates active clocks, red indicates paused or stopped clocks.&lt;/i&gt;&#10;&lt;/size&gt;" style="white-space: pre-wrap; -unity-text-align: upper-left; padding-top: 12px; padding-right: 12px; padding-bottom: 12px; padding-left: 12px;" />
                    </ui:Foldout>
                </ui:VisualElement>
                <ui:VisualElement name="pane1" class="section" style="flex-grow: 1;">
                    <ui:MultiColumnListView name="clocks-mc-list" fixed-item-height="27">
                        <ui:Columns>
                            <ui:Column name="clock-type" title="&lt;b&gt;ClockType&lt;/b&gt;" width="100px" />
                            <ui:Column name="time" title="Time" width="75px" />
                            <ui:Column name="delta-time" title="Delta Time" width="100px" />
                            <ui:Column name="time-scale" title="&lt;color=#C0FFB0&gt;Time Scale&lt;/color&gt;" width="100px" />
                            <ui:Column name="linked" title="&lt;color=#80D6FF&gt;🔗 Linked&lt;/color&gt;" width="75px" />
                        </ui:Columns>
                    </ui:MultiColumnListView>
                </ui:VisualElement>
            </ui:ScrollView>
        </ui:Tab>
        <ui:Tab label="Detail" name="detail-tab">
            <ui:ScrollView class="main">
                <ui:Foldout text="&lt;b&gt;&lt;size=16&gt;&lt;color=#FFD800&gt;Clock Detail&lt;/color&gt;&lt;/size&gt;&lt;/b&gt;" value="false" focusable="false" class="section-description" style="height: -833px;">
                    <ui:Label text="&lt;size=11&gt;Inspect the internal state of a selected &lt;b&gt;Clock&lt;/b&gt; and all components currently&#10;linked to it.&#10;&#10;This panel provides two layers of debugging:&#10;&#10;&lt;b&gt;• Clock Metrics&lt;/b&gt;  &#10;Displays the real-time values of the selected clock:&#10;    • &lt;b&gt;Time&lt;/b&gt; — Total accumulated time  &#10;    • &lt;b&gt;Delta Time&lt;/b&gt; — Last tick duration  &#10;    • &lt;b&gt;Time Scale&lt;/b&gt; — Speed multiplier applied to this clock  &#10;&#10;&lt;b&gt;• Linked Components&lt;/b&gt;  &#10;A dynamic list of objects bound to the clock, including:&#10;    • &lt;b&gt;Target Type&lt;/b&gt; — The component or system using the clock  &#10;    • &lt;b&gt;Game Object&lt;/b&gt; — Scene object associated with the component (if any)  &#10;    • &lt;b&gt;Scene Name&lt;/b&gt; — The Unity scene containing this object  &#10;    • &lt;b&gt;Hierarchy Path&lt;/b&gt; — Full transform path for quick navigation  &#10;&#10;Use this panel to verify timing behavior, detect incorrect bindings, and&#10;troubleshoot clock-driven systems with precision.&#10;&#10;&lt;i&gt;&lt;color=#909090&gt;Tip:&lt;/color&gt;&lt;/i&gt;  &#10;&lt;i&gt;Press &lt;b&gt;Refresh&lt;/b&gt; to update linkage information after state changes.&lt;/i&gt;&#10;&lt;/size&gt;" style="flex-direction: column; white-space: pre-wrap; -unity-text-align: upper-left; text-overflow: clip;" />
                </ui:Foldout>
                <ui:VisualElement name="pane1" class="section" style="flex-grow: 1; flex-direction: column;">
                    <ui:EnumField label="Clock Type" value="Center" type="TimeKit.ClockType, TimeKit.Core" name="clock-type" focusable="false" style="width: 50%; font-size: 13px; padding-bottom: 0; margin-bottom: 17px;" />
                    <ui:MultiColumnListView name="clock-detail-mc-list" fixed-item-height="27" focusable="false">
                        <ui:Columns>
                            <ui:Column name="time" title="&lt;color=#FFD800&gt;&lt;b&gt;Time&lt;/b&gt;&lt;/color&gt;" width="75px" />
                            <ui:Column name="delta-time" title="Delta Time" width="100px" />
                            <ui:Column name="time-scale" title="&lt;color=#C0FFB0&gt;Time Scale&lt;/color&gt;" width="100px" />
                            <ui:Column name="state" title="&lt;b&gt;&lt;color=#FF7474&gt;State&lt;/color&gt;&lt;/b&gt;" width="75px" />
                        </ui:Columns>
                    </ui:MultiColumnListView>
                </ui:VisualElement>
                <ui:VisualElement name="pane3" class="section" style="flex-grow: 1;">
                    <ui:VisualElement name="paneA" class="section" style="flex-grow: 1; flex-direction: row;">
                        <ui:Label text="Clock Type: (none)" name="clock-type-label" style="font-size: 15px; -unity-font-style: bold; position: relative; left: auto;" />
                        <ui:Button text="Refresh" name="refresh-button" double-click-selects-word="false" focusable="false" style="position: absolute; right: 0; left: auto; margin-right: 20px; -unity-font-style: bold;" />
                    </ui:VisualElement>
                    <ui:MultiColumnListView name="linked-detail-mc-list" fixed-item-height="28" focusable="false" style="font-size: 13px;">
                        <ui:Columns>
                            <ui:Column name="target-type" title="&lt;b&gt;Type&lt;/b&gt;" min-width="100px" width="125px" />
                            <ui:Column name="game-object" title="&lt;color=#C0FFB0&gt;🧩 GameObject&lt;/color&gt;" width="160px" />
                            <ui:Column name="scene-name" title="&lt;color=#87CEFA&gt;📄 Scene&lt;/color&gt;" width="125px" />
                            <ui:Column name="hierarchy-path" title="&lt;color=#AAAAAA&gt;📍&lt;/color&gt; &lt;color=#CCCCCC&gt;Hierarchy Path&lt;/color&gt;" width="250px" />
                        </ui:Columns>
                    </ui:MultiColumnListView>
                </ui:VisualElement>
            </ui:ScrollView>
        </ui:Tab>
        <ui:Tab label="Clock Types" name="clock-types-tab" />
    </ui:TabView>
</ui:UXML>
